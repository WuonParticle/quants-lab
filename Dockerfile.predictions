# Use an official Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory in the container
WORKDIR /quants-lab

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV CONDA_ENV_NAME quants-lab

# Install system dependencies required for some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    # Add any other system dependencies your models/packages might need (e.g., for TA-Lib)
    # libta-lib-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda for environment management (optional, but good for consistency)
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda && \
    rm ~/miniconda.sh && \
    /opt/conda/bin/conda clean -tipsy && \
    ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh && \
    echo ". /opt/conda/etc/profile.d/conda.sh" >> ~/.bashrc && \
    echo "conda activate $CONDA_ENV_NAME" >> ~/.bashrc

# Make RUN commands use the Miniconda anaconda
ENV PATH /opt/conda/bin:$PATH

# Copy the environment file and create the conda environment
COPY environment.yml environment.yml
RUN conda env create -f environment.yml && conda clean -afy

# Make conda environment activate on login
SHELL ["conda", "run", "-n", "quants-lab", "/bin/bash", "-c"]

# Copy the rest of the application code into the container
COPY . .

# Ensure model and config directories exist (especially if they are gitignored or dynamically created)
RUN mkdir -p /quants-lab/models
RUN mkdir -p /quants-lab/config

# Command to run the prediction service
# The actual config file can be overridden by docker-compose environment variables
CMD ["conda", "run", "--no-capture-output", "-n", "quants-lab", "python3", "run_prediction_service.py", "--config", "config/prediction_services.yml"] 